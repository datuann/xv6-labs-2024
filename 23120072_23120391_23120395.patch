+// kernel/kalloc.c
+// Giả sử bạn có thể đếm số trang trống trong kfree list
+uint64
+freemem_count()
+{
+  // Thêm logic để đếm số trang trống, sau đó nhân với PGSIZE
+  // (Cách triển khai cụ thể phụ thuộc vào phiên bản Xv6 của bạn)
+
+  // Ví dụ đơn giản, nếu kfree_list được bảo vệ bằng lock:
+  uint64 count = 0;
+  acquire(&kmem.lock);
+  struct run *r = kmem.freelist;
+  while (r) {
+      count++;
+      r = r->next;
+  }
+  release(&kmem.lock);
+  return count * PGSIZE;
+}
